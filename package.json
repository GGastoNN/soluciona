{
  "name": "soluciona",
  "version": "0.9.2",
  "private": true,
  "scripts": {
    "dev:r2": "npm --prefix worker-r2 run dev",
    "deploy:r2": "npm --prefix worker-r2 run deploy",
    "dev:marketplace": "npm --prefix worker-marketplace run dev",
    "deploy:marketplace": "npm --prefix worker-marketplace run deploy",
    "typecheck:marketplace": "npm --prefix worker-marketplace run typecheck",
    "check:r2": "npm --prefix worker-r2 run check",
    "test": "node --test tests/*.test.cjs firebase/functions/tests/*.test.cjs",
    "deploy:functions": "firebase deploy --only functions:soluciona-priority --config firebase/firebase.json"
  }
}

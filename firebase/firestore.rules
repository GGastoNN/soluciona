rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function accountAllowed() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return !exists(path) || (
        (!('accountStatus' in get(path).data) || !(get(path).data.accountStatus in ['SUSPENDED','DEACTIVATED']))
        && (!('tokensValidAfter' in get(path).data) || request.auth.token.auth_time >= get(path).data.tokensValidAfter));
    }
    function signedIn() { return request.auth != null && accountAllowed(); }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function emailVerified() { return signedIn() && request.auth.token.email_verified == true; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function userRole() {
      return signedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : null;
    }
    function approvedProfessional() {
      return signedIn()
        && userRole() == 'PROFESSIONAL'
        && get(/databases/$(database)/documents/professionals/$(request.auth.uid)).data.verificationStatus == 'APPROVED';
    }


    match /identity_submissions/{uid} {
      function imageValid(field) {
        return !(field in request.resource.data) || (
          request.resource.data[field].keys().hasOnly(['storageKey','contentType','size'])
          && request.resource.data[field].storageKey is string
          && request.resource.data[field].storageKey.matches('identities/' + uid + '/[A-Za-z0-9-]+')
          && request.resource.data[field].contentType in ['image/jpeg','image/png','image/webp']
          && request.resource.data[field].size is int
          && request.resource.data[field].size > 0 && request.resource.data[field].size <= 10485760);
      }
      function pendingUpload() { return owner(uid) && emailVerified()
        && request.resource.data.uid == uid && request.resource.data.status == 'PENDING'
        && request.resource.data.reviewNote == '' && request.resource.data.consentVersion == 'identity-v1'
        && request.resource.data.updatedAt is timestamp && request.resource.data.consentedAt is timestamp
        && imageValid('front') && imageValid('back'); }
      allow read: if owner(uid);
      allow create: if pendingUpload() && request.resource.data.keys().hasOnly(['uid','front','back','status','reviewNote','consentVersion','consentedAt','updatedAt']);
      allow update: if pendingUpload() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['front','back','status','reviewNote','consentVersion','consentedAt','updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['front','back']);
      allow delete: if false;
    }
    match /users/{uid}/notification_devices/{deviceId} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['token','enabled','platform','updatedAt'])
        && request.resource.data.token is string && request.resource.data.token.size() > 10 && request.resource.data.token.size() < 4096
        && request.resource.data.enabled is bool && request.resource.data.platform == 'ANDROID'
        && request.resource.data.updatedAt is timestamp;
    }
    match /notification_receipts/{receiptId} { allow read, write: if false; }

    match /zones/{zoneId} {
      allow read: if true;
      allow write: if admin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if admin();
    }

    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create: if owner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role in ['CLIENT', 'PROFESSIONAL'];
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.accountStatus == resource.data.accountStatus
        || admin();
      allow delete: if false;
    }

    match /users_private/{uid} {
      allow read, create: if owner(uid) || admin();
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'address', 'updatedAt'])
        || admin();
      allow delete: if false;
    }

    match /professionals/{uid} {
      allow read: if (signedIn() && resource.data.verificationStatus == 'APPROVED') || owner(uid) || admin();
      allow create: if owner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.verificationStatus == 'PENDING_DOCUMENTS'
        && request.resource.data.availability == false;
      allow update: if owner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.verificationStatus == resource.data.verificationStatus
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'availability', 'services', 'zones', 'primaryZone', 'updatedAt'
        ])
        && (!request.resource.data.availability || resource.data.verificationStatus == 'APPROVED')
        || admin();
      allow delete: if false;
    }

    match /professional_private/{uid} {
      allow read, create: if owner(uid) || admin();
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'licenseNumber', 'licenseJurisdiction', 'backgroundCheckStatus', 'insuranceStatus', 'updatedAt'
        ]) || admin();
      allow delete: if false;
    }

    match /professional_documents/{docId} {
      allow read: if signedIn() && (resource.data.professionalUid == request.auth.uid || admin());
      allow create: if emailVerified()
        && request.resource.data.professionalUid == request.auth.uid
        && request.resource.data.status == 'PENDING';
      allow update, delete: if false;
    }

    match /service_requests/{requestId} {
      allow create: if emailVerified()
        && userRole() == 'CLIENT'
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.professionalUid == null
        && request.resource.data.status == 'REQUESTED'
        && request.resource.data.budgetRequired == true
        && !('budget' in request.resource.data) && !('approvedTotalCents' in request.resource.data)
        && !('photoCount' in request.resource.data);

      allow read: if signedIn() && (
        resource.data.clientUid == request.auth.uid
        || resource.data.professionalUid == request.auth.uid
        || admin()
        || (approvedProfessional() && resource.data.status == 'REQUESTED')
      );

      allow update: if signedIn() && (
        (resource.data.clientUid == request.auth.uid
          && resource.data.status in ['REQUESTED','ACCEPTED','ON_THE_WAY','IN_PROGRESS','AWAITING_PAYMENT','PAYMENT_REVIEW']
          && request.resource.data.status == 'CANCELLED'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledAt','updatedAt']))
        ||
        (approvedProfessional()
          && resource.data.status == 'REQUESTED'
          && resource.data.professionalUid == null
          && (resource.data.preferredProfessionalUid == null || resource.data.preferredProfessionalUid == request.auth.uid)
          && request.resource.data.professionalUid == request.auth.uid
          && request.resource.data.status == 'ACCEPTED'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['professionalUid','status','acceptedAt','updatedAt']))
        ||
        (resource.data.professionalUid == request.auth.uid
          && request.resource.data.professionalUid == resource.data.professionalUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
          && (
            (resource.data.status == 'ACCEPTED' && request.resource.data.status == 'ON_THE_WAY')
            || (resource.data.status == 'ON_THE_WAY' && request.resource.data.status == 'IN_PROGRESS'
              && (!('budgetRequired' in resource.data) || resource.data.budgetRequired != true
                || (resource.data.approvedTotalCents > 0 && resource.data.budget.status == 'APPROVED')))
          ))
        || admin()
      );
      allow update: if owner(resource.data.clientUid) && resource.data.status == 'REQUESTED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoCount'])
        && request.resource.data.photoCount is int && request.resource.data.photoCount <= 6
        && request.resource.data.photoCount == (('photoCount' in resource.data) ? resource.data.photoCount + 1 : 1);
      allow delete: if false;
      match /budgets/{revision} {
        allow read: if signedIn() && (request.auth.uid == get(/databases/$(database)/documents/service_requests/$(requestId)).data.clientUid
          || request.auth.uid == get(/databases/$(database)/documents/service_requests/$(requestId)).data.professionalUid);
        allow write: if false;
      }
      match /attachments/{photoId} {
        function service() { return get(/databases/$(database)/documents/service_requests/$(requestId)).data; }
        function photoReader() { return signedIn() && (service().clientUid == request.auth.uid || service().professionalUid == request.auth.uid
          || (approvedProfessional() && service().status == 'REQUESTED'
            && service().categoryId in get(/databases/$(database)/documents/professionals/$(request.auth.uid)).data.services
            && service().zoneId in get(/databases/$(database)/documents/professionals/$(request.auth.uid)).data.zones
            && (service().preferredProfessionalUid == null || service().preferredProfessionalUid == request.auth.uid))); }
        allow read: if photoReader();
        allow create: if emailVerified() && service().clientUid == request.auth.uid && service().status == 'REQUESTED'
          && request.resource.data.keys().hasOnly(['storageKey','contentType','size','ownerUid','createdAt'])
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.storageKey == 'request-photos/' + requestId + '/' + request.auth.uid + '/' + photoId
          && request.resource.data.contentType in ['image/jpeg','image/png','image/webp']
          && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 10485760
          && getAfter(/databases/$(database)/documents/service_requests/$(requestId)).data.photoCount <= 6
          && getAfter(/databases/$(database)/documents/service_requests/$(requestId)).data.photoCount == (('photoCount' in service()) ? service().photoCount + 1 : 1);
        allow update, delete: if false;
      }
    }

    match /service_request_private/{requestId} {
      allow create: if emailVerified()
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.professionalUid == null;
      allow read: if signedIn() && (
        resource.data.clientUid == request.auth.uid
        || resource.data.professionalUid == request.auth.uid
        || admin()
      );
      allow update: if signedIn()
        && resource.data.professionalUid == null
        && request.resource.data.professionalUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['professionalUid','updatedAt'])
        && getAfter(/databases/$(database)/documents/service_requests/$(requestId)).data.professionalUid == request.auth.uid
        || admin();
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && get(/databases/$(database)/documents/service_requests/$(chatId)).data.professionalUid == request.auth.uid;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','updatedAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if signedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if emailVerified()
        && request.resource.data.clientUid == request.auth.uid
        && get(/databases/$(database)/documents/service_requests/$(request.resource.data.requestId)).data.clientUid == request.auth.uid
        && get(/databases/$(database)/documents/service_requests/$(request.resource.data.requestId)).data.status == 'COMPLETED';
      allow update: if signedIn()
        && resource.data.clientUid == request.auth.uid
        && request.resource.data.clientUid == resource.data.clientUid
        && request.resource.data.requestId == resource.data.requestId;
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read: if signedIn() && (resource.data.reporterUid == request.auth.uid || admin());
      allow update, delete: if false;
    }

    match /admin_audit/{auditId} {
      allow read: if admin();
      allow write: if false;
    }

    match /stats_daily/{docId} {
      allow read: if admin();
      allow write: if false;
    }
  }
}
